# PayPal (checkout) — ver docs/paypal-go-live-checklist.md antes de pasar a producción.

# Client ID de la app de PayPal (sandbox o live). Público a propósito: lo usa
# el SDK de PayPal en el navegador (@paypal/react-paypal-js) para renderizar
# los botones. NEXT_PUBLIC_ porque debe llegar al bundle de cliente.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Secret de la misma app de PayPal. NUNCA con prefijo NEXT_PUBLIC_ y NUNCA
# importado desde un archivo "use client" — solo lo lee lib/paypal/client.ts
# (server-only), usado por los route handlers de app/api/paypal/*.
PAYPAL_CLIENT_SECRET=

# Base de la API REST de PayPal. Sandbox por defecto; en producción cambia a
# https://api-m.paypal.com (ver checklist de go-live).
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
